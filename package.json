{
  "name": "olera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:seed:test": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-test.ts",
    "db:seed:test:verify": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-test.ts verify",
    "db:seed:test:reset": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-test.ts reset"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@headlessui/react": "^1.7.19",
    "@prisma/client": "^6.2.0",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "isomorphic-dompurify": "^2.35.0",
    "leaflet": "^1.9.4",
    "marked": "^17.0.1",
    "next": "^15.1.0",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.17"
  }
}
