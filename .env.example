# ==============================================================================
# OLERA PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/olera?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# ------------------------------------------------------------------------------
# CRITICAL: Generate a random secret with: openssl rand -base64 32
# MUST be different in production than in development
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Base URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# FILE STORAGE (Vercel Blob - REQUIRED for image uploads)
# ------------------------------------------------------------------------------
# Get this token from: https://vercel.com/dashboard/stores
# Click "Create Store" → "Blob" → Copy "Read-Write Token"
# WITHOUT this token, image uploads (provider photos, profile pictures) will FAIL
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------

# Video Calling (optional - currently uses placeholder links)
# Zoom API (for real Zoom integration)
# ZOOM_CLIENT_ID="your_zoom_client_id"
# ZOOM_CLIENT_SECRET="your_zoom_client_secret"

# Google Meet API (for real Google Meet integration)
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Error Tracking (optional)
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# ------------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# ------------------------------------------------------------------------------

# Node environment (development | production | test)
# NODE_ENV="development"

# Port for local development (optional, defaults to 3000)
# PORT=3000

# Enable debug logging (optional, for troubleshooting)
# DEBUG="*"

# ==============================================================================
# SETUP CHECKLIST:
# ==============================================================================
# [ ] 1. Copy this file to .env
# [ ] 2. Update DATABASE_URL with your PostgreSQL credentials
# [ ] 3. Generate new NEXTAUTH_SECRET (run: openssl rand -base64 32)
# [ ] 4. Create Vercel Blob store and add BLOB_READ_WRITE_TOKEN
# [ ] 5. Run: npm install
# [ ] 6. Run: npx prisma generate
# [ ] 7. Run: npx prisma migrate dev
# [ ] 8. Run: npx prisma db seed (optional - adds demo data)
# [ ] 9. Run: npm run dev
# ==============================================================================
